<?php

$iiifManifestUrl = $block->dataValue('iiifManifestUrl');
$width = $block->dataValue('width') ?: '100%';
$height = $block->dataValue('height') ?: '600px';

if (empty($iiifManifestUrl)) {
    echo '<p>Please provide a IIIF Manifest URL in the block settings.</p>';
    return;
}

// Generate a unique ID for this viewer instance.
$viewerId = 'glycerine-viewer-' . uniqid('', true);
$escapedViewerId = $this->escapeHtmlAttr($viewerId);
$jsConfig = json_encode([
    'width' => $width,
    'height' => $height,
    'manifest' => $iiifManifestUrl,
], JSON_UNESCAPED_SLASHES | JSON_HEX_TAG);
?>

<div id="<?php echo $escapedViewerId; ?>"></div>

<script>(function() {
    var ele = document.getElementById(<?php echo json_encode($viewerId, JSON_HEX_TAG); ?>);
    var viewer = new GlycerineViewer(ele, <?php echo $jsConfig; ?>);
    viewer.init();
})();</script>


<style>
    .field {
        display: block !important;
    }
</style>